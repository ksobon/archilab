<Project>

	<!-- Package version: <year>.<day of year>.<target ordinal>, e.g. 2026.216.270.
	     See the Versioning section of README.md for why it is shaped this way.

	     ArchilabTargetOrdinal identifies which build this is, as the two-digit
	     Revit year times ten plus the Revit update within that year: Revit 2027
	     is 270, and a hypothetical Revit 2025.5 needing its own build alongside
	     2025.0 would be 255 against 250. It is not simply the Revit year because
	     one Revit year can need more than one concurrent build (a mid-cycle
	     update that changes the .NET runtime forces exactly that), and those
	     builds need distinct, ordered versions.

	     The build is the single source of this number: scripts/package.ps1 reads
	     it back off the compiled assembly rather than recomputing it, so the
	     stamped assembly, pkg.json and the zip name can never disagree.

	     Imported after each project file so the project's properties are set.
	     Override ArchilabBuildDate to reproduce an earlier release. -->
	<PropertyGroup Condition="'$(ArchilabTargetOrdinal)' != ''">
		<ArchilabBuildDate Condition="'$(ArchilabBuildDate)' == ''">$([System.DateTime]::Now.ToString(yyyy-MM-dd))</ArchilabBuildDate>
		<Version>$([System.DateTime]::Parse($(ArchilabBuildDate)).Year).$([System.DateTime]::Parse($(ArchilabBuildDate)).DayOfYear).$(ArchilabTargetOrdinal)</Version>
	</PropertyGroup>

</Project>
